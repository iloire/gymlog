# Turso / libSQL
# Local dev can use a file DB: TURSO_DATABASE_URL="file:./local.db"
TURSO_DATABASE_URL="libsql://gymlog-<org>.turso.io"
TURSO_AUTH_TOKEN=""

# NextAuth v5 — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public
NEXT_PUBLIC_APP_NAME="gymlog"

# Register the service worker in dev to test offline behaviour
NEXT_PUBLIC_SW_IN_DEV="false"
